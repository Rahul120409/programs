    printf("Enter the Number :");
    scanf("%d",&n);

    printf("Enter the Number of Bits:");
    scanf("%d",&bits);

    binary=(unsigned int)n & ((1U<<bits)-1);
    printf("Binary: ");
    for(i=bits-1;i>=0;i--){
        printf("%d",(binary>>i)&1);
    }

    ones=(~binary) & ((1U<<bits)-1);
    printf("\nOnes: ");
    for(i=bits-1;i>=0;i--){
        printf("%d",(ones>>i)&1);
    }

    twos=(ones+1) & ((1U<<bits)-1);
    printf("\ntwos: ");
    for(i=bits-1;i>=0;i--){
        printf("%d",(twos>>i)&1);
    }

    return 0;
