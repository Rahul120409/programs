    printf("Enter the First Binary:");
    scanf("%s",&bin1);

    printf("Enter the Second Binary: ");
    scanf("%s",&bin2);

    for(i=0; bin1[i] != '\0'; i++){
        a=a*2+(bin1[i]-'0');
    }
    for (i=0;bin2[i] !='\0'; i++){
        b=b*2+(bin2[i]-'0');
    }

