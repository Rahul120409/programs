 </div>
 <script>
var message = "Learn Today, Lead Tomorrow!";
 var i = 0;
 var timer;
 function animateText() {
 clearInterval(timer);
 i = 0;
 document.getElementById("text").textContent = "";
 timer = setInterval(function() {
 if (i < message.length) {
 document.getElementById("text").textContent += message.charAt(i);
 i++;
 } else {
 clearInterval(timer);
 }
 }, 100);
 }
 animateText();
 </script>
